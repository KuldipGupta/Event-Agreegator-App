# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGO_URI=mongodb://localhost:27017/event-management

# JWT Configuration
JWT_SECRET=your-secret-key-here
JWT_EXPIRE=7d

# Email Configuration for Reminders
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-gmail-app-password

# SMS Configuration for Mobile Notifications
# Default URL targets Fast2SMS. Replace with your provider endpoint if different.
SMS_API_KEY=your-sms-api-key
SMS_API_URL=https://www.fast2sms.com/dev/bulkV2
SMS_ROUTE=q
SMS_SENDER_ID=FSTSMS

# For Gmail App Password:
# 1. Go to https://myaccount.google.com/security
# 2. Enable 2-Step Verification
# 3. Go to App Passwords
# 4. Generate a password for "Mail"
# 5. Use that 16-character password here

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS Configuration
CLIENT_URL=http://localhost:3000
